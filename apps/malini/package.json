{
	"name": "malini",
	"productName": "Malini",
	"version": "0.1.0",
	"description": "Local-only agent workstreams that turn repeated prompts into jobs",
	"private": true,
	"license": "AGPL-3.0-only",
	"main": "./out/main/index.js",
	"author": "Szymon Grącki",
	"scripts": {
		"dev": "node scripts/generate-contract-reference.mjs && install-electron && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-bundle.mjs electron-vite dev --watch",
		"dogfood": "node scripts/dogfood.mjs",
		"build": "node scripts/generate-contract-reference.mjs && electron-vite build",
		"build:demo": "vite build --config vite.demo.config.ts",
		"dev:demo": "vite --config vite.demo.config.ts",
		"start": "install-electron && node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/dev-bundle.mjs electron-vite preview",
		"check": "node ../../packages/agent-bridge/scripts/generate-protocol.mjs --check && node scripts/generate-contract-reference.mjs --check && svelte-check --tsconfig ./tsconfig.web.json && tsc -p tsconfig.node.json --noEmit",
		"lint": "pnpm run test:scripts && eslint .",
		"test": "vitest run",
		"test:scripts": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test scripts/*.test.mjs",
		"generate:file-icons": "node scripts/generate-file-icons.mjs",
		"generate:contract-reference": "node scripts/generate-contract-reference.mjs",
		"diagnostics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/diagnostics.mjs",
		"test:e2e": "install-electron && electron-vite build && playwright test",
		"dist": "pnpm --filter \"malini^...\" build && electron-vite build && node scripts/fetch-gh.mjs && electron-builder --mac --dir -c.mac.identity=null -c.forceCodeSigning=false -c.publish=null",
		"release": "pnpm --filter \"malini^...\" build && electron-vite build && node scripts/fetch-gh.mjs && electron-builder --mac --publish never",
		"test:update": "pnpm --filter \"malini^...\" build && electron-vite build && node scripts/fetch-gh.mjs && node scripts/update-e2e.mjs"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@fontsource-variable/inter": "^5.3.0",
		"@fontsource-variable/stix-two-text": "^5.3.0",
		"@malini-extension/repository": "workspace:*",
		"@malini/agent-bridge": "workspace:*",
		"@malini/eslint-plugin-hyper-ui": "workspace:*",
		"@malini/extension-api": "workspace:*",
		"@malini/hyper-ui": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tiptap/core": "^3.32.0",
		"@tiptap/extension-blockquote": "^3.32.0",
		"@tiptap/extension-bold": "^3.32.0",
		"@tiptap/extension-code": "^3.32.0",
		"@tiptap/extension-code-block": "^3.32.0",
		"@tiptap/extension-document": "^3.32.0",
		"@tiptap/extension-hard-break": "^3.32.0",
		"@tiptap/extension-heading": "^3.32.0",
		"@tiptap/extension-horizontal-rule": "^3.32.0",
		"@tiptap/extension-italic": "^3.32.0",
		"@tiptap/extension-list": "^3.32.0",
		"@tiptap/extension-paragraph": "^3.32.0",
		"@tiptap/extension-strike": "^3.32.0",
		"@tiptap/extension-text": "^3.32.0",
		"@tiptap/extensions": "^3.32.0",
		"@tiptap/pm": "^3.32.0",
		"@types/node": "catalog:",
		"daisyui": "catalog:",
		"dompurify": "^3.4.15",
		"electron": "catalog:",
		"electron-builder": "^26.16.1",
		"electron-updater": "^6.8.9",
		"electron-vite": "^5.0.0",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"jsdom": "^30.0.0",
		"marked": "catalog:",
		"material-icon-theme": "5.37.0",
		"prosemirror-markdown": "^1.13.8",
		"svelte": "catalog:",
		"svelte-check": "^4.7.6",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
