{
	"name": "malini",
	"productName": "malini",
	"version": "0.1.0",
	"description": "Local-only agent workstreams that turn repeated prompts into routines",
	"private": true,
	"license": "AGPL-3.0-only",
	"main": "./out/main/index.js",
	"author": "Best Boy",
	"scripts": {
		"dev": "electron-vite dev --watch",
		"build": "electron-vite build",
		"start": "electron-vite preview",
		"check": "node ../../packages/agent-bridge/scripts/generate-protocol.mjs --check && svelte-check --tsconfig ./tsconfig.web.json && tsc -p tsconfig.node.json --noEmit",
		"lint": "pnpm run test:scripts && eslint .",
		"test": "vitest run",
		"test:scripts": "node --test scripts/*.test.mjs",
		"generate:file-icons": "node scripts/generate-file-icons.mjs",
		"diagnostics": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/diagnostics.mjs",
		"test:e2e": "electron-vite build && playwright test",
		"dist": "pnpm --filter @malini/agent-bridge build && electron-vite build && electron-builder --mac --dir"
	},
	"devDependencies": {
		"@eslint/js": "catalog:",
		"@fontsource-variable/geist": "^5.3.0",
		"@fontsource-variable/geist-mono": "^5.3.0",
		"@malini-extension/repository": "workspace:*",
		"@malini/agent-bridge": "workspace:*",
		"@malini/eslint-plugin-hyper-ui": "workspace:*",
		"@malini/extension-api": "workspace:*",
		"@malini/hyper-ui": "workspace:*",
		"@playwright/test": "^1.63.0",
		"@sveltejs/vite-plugin-svelte": "catalog:",
		"@tailwindcss/vite": "catalog:",
		"@tiptap/core": "^3.31.4",
		"@tiptap/extension-bold": "^3.31.4",
		"@tiptap/extension-code": "^3.31.4",
		"@tiptap/extension-code-block": "^3.31.4",
		"@tiptap/extension-document": "^3.31.4",
		"@tiptap/extension-hard-break": "^3.31.4",
		"@tiptap/extension-italic": "^3.31.4",
		"@tiptap/extension-list": "^3.31.4",
		"@tiptap/extension-paragraph": "^3.31.4",
		"@tiptap/extension-strike": "^3.31.4",
		"@tiptap/extension-text": "^3.31.4",
		"@tiptap/extensions": "^3.31.4",
		"@tiptap/pm": "^3.31.4",
		"@types/node": "catalog:",
		"daisyui": "catalog:",
		"dompurify": "^3.4.15",
		"electron": "^44.4.0",
		"electron-builder": "^26.16.1",
		"electron-vite": "^5.0.0",
		"eslint": "catalog:",
		"eslint-config-prettier": "catalog:",
		"jsdom": "^30.0.0",
		"marked": "^15.0.12",
		"material-icon-theme": "5.37.0",
		"posthog-node": "^5.53.0",
		"prosemirror-markdown": "^1.13.8",
		"svelte": "catalog:",
		"svelte-check": "^4.7.6",
		"tailwindcss": "catalog:",
		"typescript": "catalog:",
		"typescript-eslint": "catalog:",
		"vite": "catalog:",
		"vitest": "catalog:"
	}
}
