{
	"$schema": "https://json-schema.org/draft/2020-12/schema",
	"$id": "https://malini.dev/schemas/extension-manifest-v1.json",
	"title": "Malini Extension Manifest v1",
	"type": "object",
	"additionalProperties": false,
	"required": [
		"schemaVersion",
		"id",
		"name",
		"version",
		"apiVersion",
		"description",
		"publisher",
		"entrypoint",
		"activationEvents"
	],
	"properties": {
		"schemaVersion": { "const": 1 },
		"id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[.-][a-z0-9]+)+$" },
		"name": { "type": "string", "minLength": 1 },
		"version": {
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+(?:-[0-9A-Za-z.-]+)?(?:\\+[0-9A-Za-z.-]+)?$"
		},
		"apiVersion": { "const": 1 },
		"description": { "type": "string", "minLength": 1 },
		"publisher": { "type": "string", "minLength": 1 },
		"entrypoint": { "type": "string", "minLength": 1 },
		"activationEvents": {
			"type": "array",
			"minItems": 1,
			"uniqueItems": true,
			"items": {
				"type": "string",
				"pattern": "^(onStartup|onWorkstream|onCommand:.+|onEvent:.+)$"
			}
		},
		"contributes": {
			"type": "object",
			"additionalProperties": false,
			"properties": {
				"panels": { "$ref": "#/$defs/panels" },
				"commands": { "$ref": "#/$defs/commands" },
				"settings": { "$ref": "#/$defs/settings" },
				"workflows": { "$ref": "#/$defs/workflows" }
			}
		}
	},
	"$defs": {
		"id": { "type": "string", "pattern": "^[a-z][a-z0-9]*(?:[._-][a-z0-9]+)*$" },
		"panels": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "label", "icon"],
				"properties": {
					"id": { "$ref": "#/$defs/id" },
					"label": { "type": "string", "minLength": 1 },
					"icon": { "type": "string", "minLength": 1 },
					"order": { "type": "number" },
					"defaultVisible": { "type": "boolean" },
					"minWidth": { "type": "integer", "exclusiveMinimum": 0 },
					"instances": { "type": "boolean" }
				}
			}
		},
		"commands": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "title"],
				"properties": {
					"id": { "$ref": "#/$defs/id" },
					"title": { "type": "string", "minLength": 1 },
					"description": { "type": "string" }
				}
			}
		},
		"settings": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "label", "type", "default"],
				"properties": {
					"id": { "$ref": "#/$defs/id" },
					"label": { "type": "string", "minLength": 1 },
					"description": { "type": "string" },
					"type": { "enum": ["string", "number", "boolean", "select"] },
					"default": { "type": ["string", "number", "boolean"] },
					"scope": { "enum": ["global", "repository", "workstream"] },
					"options": {
						"type": "array",
						"minItems": 1,
						"items": {
							"type": "object",
							"additionalProperties": false,
							"required": ["label", "value"],
							"properties": {
								"label": { "type": "string", "minLength": 1 },
								"value": { "type": "string", "minLength": 1 }
							}
						}
					}
				}
			}
		},
		"workflows": {
			"type": "array",
			"items": {
				"type": "object",
				"additionalProperties": false,
				"required": ["id", "label"],
				"properties": {
					"id": { "$ref": "#/$defs/id" },
					"label": { "type": "string", "minLength": 1 },
					"description": { "type": "string" }
				}
			}
		}
	}
}
