{
	"contractName": "malini.agent-bridge",
	"protocolVersion": 17,
	"readyTimeoutMs": 10000,
	"heartbeatIntervalMs": 1000,
	"heartbeatTimeoutMs": 5000,
	"commandAckTimeoutMs": 5000,
	"maxFrameBytes": 1048576,
	"maxDiagnosticBytes": 16384,
	"agentAttachmentsPath": ".malini/agent-attachments",
	"sandboxScratchPath": ".malini/sandbox",
	"defaultModel": "default",
	"models": ["default", "opus", "sonnet", "haiku"],
	"commands": [
		"start_session",
		"send_prompt",
		"cancel_run",
		"close_session",
		"approve",
		"answer_question",
		"refresh_capabilities",
		"refresh_mcp_status"
	],
	"events": [
		"run.started",
		"user.message",
		"assistant.message",
		"assistant.delta",
		"thinking.message",
		"thinking.delta",
		"plan.updated",
		"tool.started",
		"tool.completed",
		"tool.failed",
		"tool.input.delta",
		"command.started",
		"command.completed",
		"file.changed",
		"approval.requested",
		"question.requested",
		"usage.updated",
		"mcp.status",
		"run.completed",
		"run.failed",
		"session.state"
	],
	"controls": [
		"bridge.ready",
		"bridge.capabilities",
		"bridge.heartbeat",
		"bridge.command_ack",
		"bridge.protocol_error"
	]
}
