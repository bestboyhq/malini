{
	"contractName": "malini.agent-bridge",
	"protocolVersion": 33,
	"readyTimeoutMs": 10000,
	"heartbeatIntervalMs": 1000,
	"heartbeatTimeoutMs": 5000,
	"commandAckTimeoutMs": 5000,
	"maxFrameBytes": 1048576,
	"maxDiagnosticBytes": 16384,
	"agentAttachmentsPath": ".malini/agent-attachments",
	"sandboxScratchPath": ".malini/sandbox",
	"agentContextPath": ".context",
	"defaultModel": "opus",
	"models": ["opus", "sonnet", "haiku"],
	"commands": [
		"start_session",
		"send_prompt",
		"cancel_run",
		"close_session",
		"approve",
		"answer_question",
		"refresh_capabilities",
		"refresh_session_status",
		"authorize_mcp_server",
		"reconnect_mcp_server",
		"stop_task",
		"suggest_title",
		"list_skills",
		"browser_result",
		"platform_result"
	],
	"events": [
		"run.started",
		"user.message",
		"assistant.message",
		"assistant.delta",
		"thinking.message",
		"thinking.delta",
		"plan.updated",
		"tool.started",
		"tool.completed",
		"tool.failed",
		"tool.input.delta",
		"stream.discarded",
		"command.completed",
		"file.changed",
		"approval.requested",
		"question.requested",
		"usage.updated",
		"mcp.status",
		"background.updated",
		"run.completed",
		"run.failed",
		"session.state"
	],
	"controls": [
		"bridge.ready",
		"bridge.capabilities",
		"bridge.heartbeat",
		"bridge.command_ack",
		"bridge.protocol_error",
		"bridge.title",
		"bridge.skills",
		"bridge.mcp_authorization",
		"bridge.browser_request",
		"bridge.platform_request"
	],
	"platformTools": ["jobs_list", "jobs_save", "jobs_run", "events_list", "pull_requests_open_draft"]
}
